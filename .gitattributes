# Normalize all text files to LF in the repo; check out with LF everywhere.
# Stops the CRLF<->LF churn on Windows checkouts.
# NOTE: eol=lf is load-bearing for CI — the schema/kata-events.schema.json and
# app/src/bindings/kata-events.ts freshness gates compare bytes across the
# windows-latest (Rust) and ubuntu-latest (web) jobs; CRLF drift would break them.
* text=auto eol=lf

# Binary assets — never apply text/EOL conversion.
*.woff2 binary
*.woff binary
*.ttf binary
*.otf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary

# Generated files: collapsed in GitHub diffs and left out of language stats.
# The vendored ai-sdlc format program is refreshed by scripts/vendor-ai-sdlc-format.mjs.
crates/kata-sdlc/tests/ai-sdlc-format/check.mjs linguist-generated=true
crates/kata-sdlc/tests/ai-sdlc-format/THIRD_PARTY_LICENSES.txt linguist-generated=true

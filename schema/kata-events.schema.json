{
  "$defs": {
    "DiffFile": {
      "description": "One changed file in a run's changeset. Part of the `run.diff` event\npayload; produced by `crate::changeset::diff_at`.",
      "properties": {
        "path": {
          "description": "Path relative to the run's working directory (the worktree when isolated, the workdir otherwise).",
          "type": "string"
        },
        "status": {
          "description": "Git short status for the change: \"A\" | \"M\" | \"D\" | \"R\" | ...",
          "type": "string"
        }
      },
      "required": [
        "status",
        "path"
      ],
      "type": "object"
    },
    "DiffTypeStat": {
      "description": "Per-file-type slice of a run's changeset. Part of the `run.diff` payload.\n`file_type` is a lowercased file extension; `\"\"` means no extension.",
      "properties": {
        "deletions": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "file_type": {
          "description": "Lowercased file extension (\"rs\", \"ts\", \"md\"); \"\" for files with no\nextension (Makefile, LICENSE, .gitignore).",
          "type": "string"
        },
        "files": {
          "description": "Number of changed files of this type.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "insertions": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file_type",
        "files",
        "insertions",
        "deletions"
      ],
      "type": "object"
    },
    "EnvName": {
      "description": "The name of an environment variable the run sees. Never its value.",
      "properties": {
        "api_key": {
          "description": "True for the variable that holds the API key (`auth.token_env`).",
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "source",
        "name",
        "api_key"
      ],
      "type": "object"
    },
    "GivenItem": {
      "description": "One row of the view: the resolved item (without its path) and its status.\n`source` is `None` for a row Claude reported that Kata did not know.",
      "properties": {
        "brought_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "lock": {
          "anyOf": [
            {
              "$ref": "#/$defs/LockReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "off": {
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/GivenStatus"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "detail",
        "off",
        "status"
      ],
      "type": "object"
    },
    "GivenOptions": {
      "description": "The options a run was resolved with, as `run.given` records them.",
      "properties": {
        "build": {
          "type": "boolean"
        },
        "required_plugins": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "required_plugins",
        "build"
      ],
      "type": "object"
    },
    "GivenStatus": {
      "description": "One variant per distinct text the view shows. The frontend maps each to its\nwords.",
      "oneOf": [
        {
          "const": "given",
          "description": "\"given\"",
          "type": "string"
        },
        {
          "const": "passed-not-loaded",
          "description": "\"passed by Kata, not loaded by Claude\"",
          "type": "string"
        },
        {
          "const": "given-failed-to-connect",
          "description": "\"given, failed to connect\"",
          "type": "string"
        },
        {
          "const": "given-fired",
          "description": "\"given, fired\"",
          "type": "string"
        },
        {
          "const": "given-not-fired",
          "description": "\"given, has not fired\"",
          "type": "string"
        },
        {
          "const": "given-unconfirmed",
          "description": "\"given, Claude does not confirm this kind\"",
          "type": "string"
        },
        {
          "const": "switched-off-but-loaded",
          "description": "\"switched off, but Claude loaded it\"",
          "type": "string"
        },
        {
          "const": "switched-off-but-fired",
          "description": "\"switched off, but it fired\"",
          "type": "string"
        },
        {
          "const": "switched-off",
          "description": "\"switched off\"",
          "type": "string"
        },
        {
          "const": "switched-off-unconfirmed",
          "description": "\"switched off, Claude does not confirm this kind\"",
          "type": "string"
        },
        {
          "const": "loaded-source-unknown",
          "description": "\"loaded by Claude, source unknown\"",
          "type": "string"
        },
        {
          "const": "loaded-source-unknown-failed-to-connect",
          "description": "\"loaded by Claude, source unknown, failed to connect\"",
          "type": "string"
        },
        {
          "const": "fired-source-unknown",
          "description": "\"fired, source unknown\"",
          "type": "string"
        },
        {
          "const": "passed-no-start-report",
          "description": "\"passed by Kata, Claude made no start report\"",
          "type": "string"
        },
        {
          "const": "switched-off-no-start-report",
          "description": "\"switched off, Claude made no start report\"",
          "type": "string"
        }
      ]
    },
    "ItemKind": {
      "description": "The kind of thing a run starts with that can be switched off.",
      "enum": [
        "hook",
        "skill",
        "plugin",
        "instruction",
        "tool-server"
      ],
      "type": "string"
    },
    "LockReason": {
      "description": "Why an item is locked on. Every variant but `FollowsPlugin` carries the\none-line reason text the row shows.",
      "oneOf": [
        {
          "description": "Kata's own tool server or standing note.",
          "properties": {
            "kind": {
              "const": "kata",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "A plugin the mode requires, or an item it brings.",
          "properties": {
            "kind": {
              "const": "required",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "Set by the organization's managed settings.",
          "properties": {
            "kind": {
              "const": "organization",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "A build keeps the project's hooks.",
          "properties": {
            "kind": {
              "const": "build",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "No mechanism switches this kind and source off for one run.",
          "properties": {
            "kind": {
              "const": "unswitchable",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "Brought by a plugin that is not required: no switch of its own, the row\nshows its plugin's state. `plugin` is the plugin's item identity.",
          "properties": {
            "kind": {
              "const": "follows-plugin",
              "type": "string"
            },
            "plugin": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "plugin"
          ],
          "type": "object"
        }
      ]
    },
    "Question": {
      "description": "One question in an `ask.requested` batch. Part of the published event\nschema (`schema/kata-events.schema.json`); the app's TS type is generated\nfrom that schema, not hand-mirrored.",
      "properties": {
        "header": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/QuestionKind"
        },
        "multi_select": {
          "default": false,
          "type": "boolean"
        },
        "optional": {
          "default": false,
          "type": "boolean"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/QuestionOption"
          },
          "type": "array"
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "header",
        "question"
      ],
      "type": "object"
    },
    "QuestionKind": {
      "oneOf": [
        {
          "const": "confirm",
          "description": "Yes/No (or two-option) inline choice.",
          "type": "string"
        },
        {
          "const": "select",
          "description": "Single-choice (radio) or, with `multi_select`, multiple-choice (checkbox).",
          "type": "string"
        },
        {
          "const": "text",
          "description": "Free-form typed answer.",
          "type": "string"
        }
      ]
    },
    "QuestionOption": {
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "RunSetting": {
      "description": "One setting. `value` is `None` when nothing is set: \"none\" for a cap or a\ndeadline, Claude's own default for the model and the effort level.",
      "properties": {
        "source": {
          "$ref": "#/$defs/SettingSource"
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "RunSettings": {
      "description": "The settings of R17.1 the engine can resolve. The build's safety rules come\nfrom the Workbench.",
      "properties": {
        "answer_deadline": {
          "$ref": "#/$defs/RunSetting"
        },
        "effort": {
          "$ref": "#/$defs/RunSetting"
        },
        "empty_room": {
          "$ref": "#/$defs/RunSetting"
        },
        "model": {
          "$ref": "#/$defs/RunSetting"
        },
        "permission_posture": {
          "$ref": "#/$defs/RunSetting"
        },
        "spending_ceiling": {
          "$ref": "#/$defs/RunSetting"
        },
        "time_limit": {
          "$ref": "#/$defs/RunSetting"
        },
        "turn_cap": {
          "$ref": "#/$defs/RunSetting"
        }
      },
      "required": [
        "model",
        "effort",
        "permission_posture",
        "empty_room",
        "answer_deadline",
        "time_limit",
        "turn_cap",
        "spending_ceiling"
      ],
      "type": "object"
    },
    "SettingSource": {
      "description": "Where a setting's value comes from.",
      "oneOf": [
        {
          "enum": [
            "run-spec",
            "personal",
            "project",
            "project-local",
            "organization",
            "claude-default",
            "kata-default"
          ],
          "type": "string"
        },
        {
          "const": "claude-report",
          "description": "What Claude's own start report said the run started with.",
          "type": "string"
        }
      ]
    },
    "Source": {
      "description": "Where an item comes from. `ProjectLocal` is `.claude/settings.local.json`,\n`CLAUDE.local.md` and the local MCP scope in `~/.claude.json`; it displays as\n\"project\" but keeps its own identity.",
      "enum": [
        "personal",
        "project",
        "project-local",
        "plugin",
        "organization",
        "kata",
        "run-spec"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "isolation": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "spec": {
          "type": "string"
        },
        "type": {
          "const": "run.started",
          "type": "string"
        },
        "workdir": {
          "type": "string"
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "spec",
        "workdir",
        "isolation"
      ],
      "type": "object"
    },
    {
      "properties": {
        "level": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "type": {
          "const": "log",
          "type": "string"
        }
      },
      "required": [
        "type",
        "level",
        "message"
      ],
      "type": "object"
    },
    {
      "properties": {
        "parent_id": {
          "description": "`id` of the subagent call this text was written inside; absent at\nthe top level.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "type": {
          "const": "assistant.text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "type": "object"
    },
    {
      "properties": {
        "id": {
          "description": "claude's `tool_use_id`. Pairs this call with its `tool.result`.\nEmitted on every run; absent only in transcripts written before it\nexisted, or when claude sent none.",
          "type": [
            "string",
            "null"
          ]
        },
        "input": {
          "description": "Raw tool input. Only under `kata run --full-payloads`; omitted, with\n`truncated` set, when its serialized form exceeds `PAYLOAD_CAP_BYTES`."
        },
        "input_summary": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent_id": {
          "description": "`id` of the subagent call this call was made inside; absent at the\ntop level.",
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "type": {
          "const": "tool.use",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "input_summary"
      ],
      "type": "object"
    },
    {
      "properties": {
        "id": {
          "description": "The `id` of the `tool.use` this result answers.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "output": {
          "description": "The tool's output flattened to text. Only under\n`kata run --full-payloads`; cut at `PAYLOAD_CAP_BYTES` with\n`truncated` set.",
          "type": [
            "string",
            "null"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "type": {
          "const": "tool.result",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "ok",
        "summary"
      ],
      "type": "object"
    },
    {
      "properties": {
        "n": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "parent_id": {
          "description": "Set when the assistant message came from inside a subagent: the\n`id` of the `tool.use` that spawned it. Omitted at the top level.",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "const": "turn",
          "type": "string"
        }
      },
      "required": [
        "type",
        "n"
      ],
      "type": "object"
    },
    {
      "properties": {
        "cost_usd": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exit_code": {
          "format": "int32",
          "type": "integer"
        },
        "is_error": {
          "type": "boolean"
        },
        "num_turns": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "const": "run.completed",
          "type": "string"
        }
      },
      "required": [
        "type",
        "exit_code",
        "is_error",
        "num_turns",
        "duration_ms"
      ],
      "type": "object"
    },
    {
      "description": "What the run was given: every item with how Claude's own report squares\nwith what Kata passed, the run's settings, and the environment names.\nEmitted when Claude's start report arrives and again, complete, the first\ntime a hook fires; a consumer keeps only the last one. A run that ends\nbefore any start report still gets one. Never carries a value of an\nenvironment variable or a hook's command.",
      "properties": {
        "env": {
          "items": {
            "$ref": "#/$defs/EnvName"
          },
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/GivenItem"
          },
          "type": "array"
        },
        "options": {
          "$ref": "#/$defs/GivenOptions",
          "default": {
            "build": false,
            "required_plugins": []
          },
          "description": "The options the run was resolved with."
        },
        "settings": {
          "$ref": "#/$defs/RunSettings"
        },
        "type": {
          "const": "run.given",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "items",
        "settings",
        "env",
        "warnings"
      ],
      "type": "object"
    },
    {
      "properties": {
        "branch": {
          "description": "Isolation branch (`kata/<slug>-<id>`) — present only when isolated.",
          "type": [
            "string",
            "null"
          ]
        },
        "by_type": {
          "default": [],
          "description": "Changeset partitioned by file extension, sorted by `file_type`.\nA partition of the totals above: summing `by_type[*].insertions`\nequals `insertions` (same for deletions). `#[serde(default)]` so a\npre-enhancement `run.diff` transcript line still deserializes (as []).",
          "items": {
            "$ref": "#/$defs/DiffTypeStat"
          },
          "type": "array"
        },
        "deletions": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/DiffFile"
          },
          "type": "array"
        },
        "insertions": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "run.diff",
          "type": "string"
        },
        "worktree": {
          "description": "Absolute worktree path — present only for a worktree-isolated run.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "files",
        "insertions",
        "deletions"
      ],
      "type": "object"
    },
    {
      "properties": {
        "id": {
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "type": "array"
        },
        "type": {
          "const": "ask.requested",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "questions"
      ],
      "type": "object"
    },
    {
      "properties": {
        "answers": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "const": "ask.answered",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "answers"
      ],
      "type": "object"
    },
    {
      "description": "A tool call is paused on the operator's decision. Emitted only under\n`[permissions] mode = \"prompt\"` with `unmatched = \"ask\"`, and only for a\ncall no rule resolved — the exact analogue of `ask.requested`. The run\nstays paused until the matching `permission.decided`.",
      "properties": {
        "id": {
          "type": "string"
        },
        "input_summary": {
          "description": "The call's target rendered for a human: the shell command, the file\npath, the query — whatever the decision actually turns on.",
          "type": "string"
        },
        "tool": {
          "description": "The tool claude wants to use, e.g. `Bash` or `mcp__github__list_issues`.",
          "type": "string"
        },
        "type": {
          "const": "permission.requested",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "tool",
        "input_summary"
      ],
      "type": "object"
    },
    {
      "description": "How a permission check was resolved. Emitted for **every** check under\n`[permissions] mode = \"prompt\"`, including the ones a rule or the\nunmatched policy settled without pausing, so the stream is a complete\naudit trail of what the agent was allowed to do.",
      "properties": {
        "allow": {
          "type": "boolean"
        },
        "decided_by": {
          "description": "What resolved it: `unmatched-policy`, `operator`, or `engine` (one of\nKata's own bridge tools, which are exempt from the rules). A rule can\nnever appear here — the spec's `allow`/`deny` are enforced by claude\nfrom the generated settings file, and a call they resolve never\nreaches Kata. Treat an unrecognized value as \"something else decided\".",
          "type": "string"
        },
        "id": {
          "description": "Correlates with a preceding `permission.requested`, when there was one.",
          "type": "string"
        },
        "input_summary": {
          "description": "Same rendering as `permission.requested.input_summary`, repeated here\nso an auto-resolved check is legible on its own.",
          "type": "string"
        },
        "message": {
          "description": "The reason handed back to claude on a denial.",
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "type": "string"
        },
        "type": {
          "const": "permission.decided",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "tool",

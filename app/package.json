{
  "name": "kata-workbench",
  "version": "3.2.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 1420",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src",
    "test:harness": "vitest run --config harness/vitest.config.mjs",
    "typecheck:harness": "tsc -p tsconfig.harness.json --noEmit",
    "check:responsive": "node scripts/check-responsive-desktop.mjs",
    "count": "node harness/counter/counter.mjs --root . src",
    "check:boot": "node harness/gate/check-boot.mjs --route \"\" --route library --route mode --route sdlc --route sdlc/claims/2026-10-12-fnol-photo-upload",
    "firings": "node harness/driver/firing-rollup.mjs",
    "check:wiring": "node harness/counter/check-wiring.mjs --root . src",
    "check:interaction": "node harness/gate/check-interaction.mjs --route \"\" --route library --route mode --route sdlc --route sdlc/claims/2026-10-12-fnol-photo-upload",
    "check:parity": "node scripts/check-parity.mjs",
    "tauri": "tauri",
    "sidecar": "node scripts/stage-sidecar.mjs",
    "gen:events": "json2ts -i ../schema/kata-events.schema.json -o src/bindings/kata-events.ts --no-additionalProperties --bannerComment \"/* Generated from schema/kata-events.schema.json by 'npm run gen:events'. DO NOT EDIT. */\"",
    "tauri:dev": "node scripts/stage-sidecar.mjs && tauri dev",
    "tauri:build": "node scripts/stage-sidecar.mjs --release && tauri build",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "packageManager": "npm@11.0.0",
  "dependencies": {
    "@angular/cdk": "22.0.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@spartan-ng/brain": "^1.8.0",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "diff": "9.0.0",
    "highlight.js": "11.11.2",
    "mermaid": "12.2.0",
    "rehype-highlight": "7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@spartan-ng/cli": "^1.8.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.63.0",
    "playwright-core": "^1.61.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "stylelint": "^17.14.1",
    "stylelint-declaration-strict-value": "^1.12.1",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.8"
  }
}

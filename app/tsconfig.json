{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@bindings/*": ["./src/bindings/*"],
      "@spartan-ng/helm/button": ["./libs/ui/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./libs/ui/utils/src/index.ts"],
      "@spartan-ng/helm/card": ["./libs/ui/card/src/index.ts"],
      "@spartan-ng/helm/input": ["./libs/ui/input/src/index.ts"],
      "@spartan-ng/helm/table": ["./libs/ui/table/src/index.ts"],
      "@spartan-ng/helm/select": ["./libs/ui/select/src/index.ts"],
      "@spartan-ng/helm/dialog": ["./libs/ui/dialog/src/index.ts"],
      "@spartan-ng/helm/tabs": ["./libs/ui/tabs/src/index.ts"],
      "@spartan-ng/helm/badge": ["./libs/ui/badge/src/index.ts"],
      "@spartan-ng/helm/avatar": ["./libs/ui/avatar/src/index.ts"],
      "@spartan-ng/helm/tooltip": ["./libs/ui/tooltip/src/index.ts"],
      "@spartan-ng/helm/switch": ["./libs/ui/switch/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./libs/ui/textarea/src/index.ts"],
      "@spartan-ng/helm/field": ["./libs/ui/field/src/index.ts"],
      "@spartan-ng/helm/label": ["./libs/ui/label/src/index.ts"],
      "@spartan-ng/helm/separator": ["./libs/ui/separator/src/index.ts"],
      "@spartan-ng/helm/sidebar": ["./libs/ui/sidebar/src/index.ts"],
      "@spartan-ng/helm/sheet": ["./libs/ui/sheet/src/index.ts"],
      "@spartan-ng/helm/skeleton": ["./libs/ui/skeleton/src/index.ts"],
      "@spartan-ng/helm/checkbox": ["./libs/ui/checkbox/src/index.ts"],
      "@spartan-ng/helm/toggle-group": ["./libs/ui/toggle-group/src/index.ts"],
      "@spartan-ng/helm/toggle": ["./libs/ui/toggle/src/index.ts"],
      "@spartan-ng/helm/questionnaire": ["./libs/ui/questionnaire/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}

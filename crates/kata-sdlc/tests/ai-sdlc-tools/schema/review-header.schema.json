{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-sdlc.local/format/review-header.schema.json",
  "title": "The yaml block under a layout 2 review heading (## Review <n>)",
  "type": "object",
  "required": ["review", "reviewed_at", "commits"],
  "properties": {
    "review": { "type": "integer", "minimum": 1 },
    "reviewed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "commits": {
      "description": "The commit each repository was reviewed at, keyed by repository.",
      "type": "object",
      "additionalProperties": { "type": ["string", "integer"] }
    }
  },
  "additionalProperties": false
}
